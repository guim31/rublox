{
  "id": "drawing",
  "order": 6,
  "mode": "junior",
  "icon": "🎨",
  "accent": "coral",
  "recipe": {
    "name": { "fr": "Mon carnet de dessin", "en": "My sketchbook" },
    "theme": { "primary": "#e8590c", "font": "rounded" },
    "screens": [
      {
        "key": "home",
        "name": { "fr": "Accueil", "en": "Home" },
        "props": { "padding": 16, "gap": 14 },
        "components": [
          {
            "key": "title",
            "type": "Text",
            "name": { "fr": "Titre", "en": "Title" },
            "props": {
              "text": { "fr": "🎨 Mon carnet de dessin", "en": "🎨 My sketchbook" },
              "fontSize": 24,
              "bold": true,
              "align": "center"
            }
          },
          {
            "key": "sheet",
            "type": "Canvas",
            "name": { "fr": "Feuille", "en": "Sheet" },
            "props": { "height": 380, "penColor": "#1c7ed6", "penWidth": 8 }
          },
          {
            "key": "palette",
            "type": "Row",
            "name": { "fr": "Palette", "en": "Palette" },
            "props": { "justify": "center", "gap": 6, "wrap": true },
            "children": [
              {
                "key": "red",
                "type": "Icon",
                "name": { "fr": "Rouge", "en": "Red" },
                "props": {
                  "icon": "droplet",
                  "color": "#e03131",
                  "size": 40,
                  "label": { "fr": "Rouge", "en": "Red" }
                }
              },
              {
                "key": "orange",
                "type": "Icon",
                "name": { "fr": "Orange", "en": "Orange" },
                "props": {
                  "icon": "droplet",
                  "color": "#f76707",
                  "size": 40,
                  "label": { "fr": "Orange", "en": "Orange" }
                }
              },
              {
                "key": "yellow",
                "type": "Icon",
                "name": { "fr": "Jaune", "en": "Yellow" },
                "props": {
                  "icon": "droplet",
                  "color": "#fcc419",
                  "size": 40,
                  "label": { "fr": "Jaune", "en": "Yellow" }
