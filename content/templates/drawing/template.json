              },
              {
                "key": "purple",
                "type": "Icon",
                "name": { "fr": "Violet", "en": "Purple" },
                "props": {
                  "icon": "droplet",
                  "color": "#9c36b5",
                  "size": 40,
                  "label": { "fr": "Violet", "en": "Purple" }
