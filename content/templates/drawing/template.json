              "DO": {
                "block": {
                  "type": "rx_Canvas_set",
                  "fields": { "COMPONENT": "sheet", "PROP": "penColor" },
                  "inputs": {
                    "VALUE": { "block": { "type": "text", "fields": { "TEXT": "#e03131" } } }
                  },
                  "next": {
                    "block": {
                      "type": "rx_Icon_set",
                      "fields": { "COMPONENT": "pen", "PROP": "color" },
                      "inputs": {
                        "VALUE": { "block": { "type": "text", "fields": { "TEXT": "#e03131" } } }
                      }
                    }
                  }
                }
