{
  "id": "first-button",
  "mode": "junior",
  "order": 1,
  "minutes": 10,
  "accent": "indigo",
  "icon": "👋",
  "requires": ["Button", "Text"],
  "steps": [
    { "id": "welcome", "mood": "wave" },
    {
      "id": "add-button",
      "target": "palette:Button",
      "check": { "kind": "component", "type": "Button" }
    },
    {
      "id": "button-text",
      "target": "inspector:text",
      "check": { "kind": "prop", "type": "Button", "prop": "text" }
    },
    {
      "id": "add-text",
      "target": "palette:Text",
      "check": { "kind": "component", "type": "Text" }
    },
    { "id": "go-blocks", "target": "tab:blocks", "check": { "kind": "tab", "tab": "blocks" } },
    {
      "id": "event-block",
      "target": "toolbox:Button",
      "check": { "kind": "block", "type": "rx_Button_on_click" }
    },
    {
      "id": "set-block",
      "target": "toolbox:Text",
      "check": { "kind": "block", "type": "rx_Text_set", "inside": ["rx_Button_on_click"] }
    },
    {
      "id": "type-hello",
      "target": "workspace",
      "check": {
        "kind": "block",
        "type": "text",
        "inside": ["rx_Text_set", "rx_Button_on_click"],
        "filled": ["TEXT"]
      }
    },
    {
      "id": "try-it",
      "target": "preview",
      "mood": "cheer",
      "check": { "kind": "preview", "event": "click", "type": "Button" }
    }
  ]
}
