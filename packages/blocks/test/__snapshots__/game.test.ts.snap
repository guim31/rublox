// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`game blocks > passes the clone itself and the event values to handlers 1`] = `
"export default async function ({ components, app, stored, shared, screens, ui, device, rx }) {
  const { Panier, Pomme, Scene1 } = components;

  Pomme.onHit(Panier, async (Pomme, other) => {
    Pomme.delete();
    rx.log(other);
  });

  Pomme.onEdge('bottom', async (Pomme, edge) => {
    Pomme.delete();
  });

  Scene1.onFrame(async (dt) => {
    Panier.rotation = dt;
  });
}
"
`;
