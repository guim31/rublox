{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalDependencies": ["content/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "RUBLOX_*",
        "DATABASE_URL",
        "DATA_DIR",
        "STUDIO_URL",
        "APPS_URL",
        "TRUST_PROXY",
        "MAX_UPLOAD_MB",
        "LOG_LEVEL"
      ]
    }
  },
  "globalPassThroughEnv": ["E2E_PORT", "E2E_BASE_URL", "PLAYWRIGHT_CHROMIUM_PATH", "CI"]
}
